# Stage 1: Install dependencies on the build host's native architecture.
# This avoids running npm under QEMU emulation, which fails with
# "Exit handler never called" when cross-building (e.g., linux/amd64 on
# Apple Silicon). All dependencies are pure JavaScript, so the resulting
# node_modules/ is architecture-independent and can be copied into any
# target platform image.
# $BUILDPLATFORM ensures this stage always runs on the build host's native
# arch, even when --platform targets a different architecture.
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi10/nodejs-22:10.1 AS deps
WORKDIR /opt/app-root/src
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Stage 2: Final image for the requested target platform (linux/amd64, linux/arm64).
# $TARGETPLATFORM is set automatically by podman/buildah from the --platform flag.
FROM --platform=$TARGETPLATFORM registry.access.redhat.com/ubi10/nodejs-22:10.1

# Labels for OpenShift and container metadata
LABEL name="nodejs-oauth-playground-frontend" \
      version="1.0" \
      description="OAuth 2.0 Playground frontend application with OpenTelemetry tracing" \
      io.k8s.display-name="Node.js OAuth Playground Frontend" \
      io.k8s.description="A playground application for learning OAuth 2.0 flows" \
      io.openshift.tags="nodejs,oauth,keycloak,opentelemetry" \
      io.openshift.expose-services="8000:http"

# Application environment variables
ENV KC_URL=http://localhost:8080/ \
    SERVICE_URL=http://localhost:3000/secured \
    INPUT_ISSUER=http://localhost:8080/realms/demo \
    NODE_ENV=production \
    NPM_RUN=start

# OpenTelemetry environment variables
ENV OTEL_SERVICE_NAME=nodejs-oauth-playground-frontend \
    OTEL_SERVICE_VERSION=1.0.0 \
    OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317 \
    OTEL_LOG_LEVEL=info

# Set working directory
WORKDIR /opt/app-root/src

# Copy dependencies from the native build stage
COPY --from=deps --chown=1001:0 /opt/app-root/src/node_modules ./node_modules

# Copy application files with proper ownership
COPY --chown=1001:0 package*.json app.js tracing.js client.js index.html styles.css ./

# Set proper permissions for OpenShift (arbitrary user ID support)
RUN chmod -R g=u /opt/app-root/src

# Use non-root user (required by OpenShift)
USER 1001

EXPOSE 8000

CMD [ "npm", "start" ]
